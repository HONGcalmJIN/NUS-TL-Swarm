Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Arrows: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: UAVOdom
      Topic: /drone_0/odom
      Shape: Arrow
      Keep: 100
      Color: 0; 255; 0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RawCloud
      Topic: /drone_0/cloud
      Queue Size: 10
      Style: Flat Squares
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Autocompute Intensity Bounds: false
      Min Intensity: 0.0
      Max Intensity: 1.0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: OccupancyInflate
      Topic: /drone_0_grid/grid_map/occupancy_inflate
      Queue Size: 10
      Style: Squares
      Size (Pixels): 2
      Color Transformer: RGB8
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: DoorMarkers
      Topic: /door_goal_shaper/markers
      Queue Size: 10
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Pitch: 0.7
      Yaw: 0.8 